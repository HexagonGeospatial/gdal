#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GDAL_VERSION_MAJOR@,@GDAL_VERSION_MINOR@,@GDAL_VERSION_REV@,@GDAL_VERSION_BUILD@
 PRODUCTVERSION @GDAL_VERSION_MAJOR@,@GDAL_VERSION_MINOR@,@GDAL_VERSION_REV@,@GDAL_VERSION_BUILD@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Hexagon AB and/or its subsidiaries and affiliates"
      VALUE "ProductName", "GDAL Application"
      VALUE "FileDescription", "@APP_NAME@"
      VALUE "FileVersion", "@GDAL_VERSION@.@GDAL_VERSION_BUILD@"
      VALUE "ProductVersion", "@GDAL_VERSION@.@GDAL_VERSION_BUILD@"
      VALUE "OriginalFilename", "@APP_NAME@.exe"
      VALUE "LegalCopyright", "(c) 1999-2027 Hexagon AB and/or its subsidiaries and affiliates"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
